      {/* Right Section - Login Form (Mobile & Desktop) */}
      <section className="relative z-10 flex flex-col justify-between lg:justify-center px-6 py-8 sm:px-8 lg:px-16 lg:py-16 flex-1 lg:flex-none">
        {/* Mobile Header */}
        <motion.div 
